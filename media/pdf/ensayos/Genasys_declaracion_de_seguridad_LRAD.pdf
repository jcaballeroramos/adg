/* ── Industries & Use Cases Section on Home page ─────────────────────── */

/* Remove divider on last industry block */
.home-orgs_industry-block:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

/* Use case link hover */
.home-orgs_link:hover {
  color: #1a3347;
  text-decoration-color: #6dbf67;
}
  
/* ══ Genasys Infinity Marquee — Splide ══════════════ */

/* Section wrapper */
.cc-home-logos {
  padding-top: 48px;
  padding-bottom: 48px;
}

/* Splide root */
.splide.cc-marquee-logos {
  overflow: clip;
  width: 100%;
}

/* Gradient mask — fades logos at left and right edges.
   Update hex values if section background is not white. */
.gradient-mask {
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 15%,
    black 85%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 15%,
    black 85%,
    transparent 100%
  );
  padding-top: 1.6rem;
  padding-bottom: 1.6rem;
}

/* Allow Splide track to show cloned slides outside bounds */
.splide.cc-marquee-logos .splide__track {
  overflow: visible;
}

/* Each slide — flex centering */
.splide.cc-marquee-logos .splide__slide {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Logo slot box — fixed bounding box for all logo sizes */
.splide__box.cc-marquee-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16rem;
  height: 10rem;
}

/* Logo image — fits inside box regardless of orientation */
.cc-marquee-logo_img {
  width: 11rem;
  max-width: 100%;
  height: auto;
  max-height: 120px;
  object-fit: contain;
  opacity: 0.55;
  filter: grayscale(1);
  transition: opacity 0.25s ease, filter 0.25s ease;
}

.cc-marquee-logo_img:hover {
  opacity: 1;
  filter: grayscale(0);
}

/* Tablet */
@media screen and (max-width: 991px) {
  .splide__box.cc-marquee-logo {
    width: 12rem;
    height: 10rem;
  }
  .cc-marquee-logo_img {
    width: 9rem;
  }
}

/* Mobile portrait */
@media screen and (max-width: 479px) {
  .splide__box.cc-marquee-logo {
    width: 9rem;
    height: 8rem;
  }
  .cc-marquee-logo_img {
    width: 7rem;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .splide.cc-marquee-logos {
    overflow: auto;
  }
}
/* ── Genasys LRAD Solutions Tab Component ────────────────── */

/* ── Desktop pill bar ────────────────────────────────────── */
.cc-pill-item--active .cc-pill-item__label {
  color: #0d2233;
  font-weight: 600;
}
.cc-pill-item:not(.cc-pill-item--active):hover .cc-pill-item__label {
  color: #ffffff;
}

/* ── Mobile tab track ────────────────────────────────────── */
.cc-tab-track {
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  scrollbar-width: none;
  padding: 0;
}
.cc-tab-track::-webkit-scrollbar {
  display: none;
}
.cc-tab-track--grabbing {
  cursor: grabbing !important;
}

/* ── Mobile fade masks ────────────────────────────────────── */
.cc-tab-bar-outer {
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
}

/* ── Tab underline ───────────────────────────────────────── */
.cc-tab-underline {
  width: 100%;
}

/* ── Mobile tab item label states ────────────────────────── */
.cc-tab-item--active .cc-tab-item__label {
  color: #0d2233;
  font-weight: 600;
}
.cc-tab-item:hover .cc-tab-item__label {
  color: #4a6070;
  font-weight: 600;
}

/* ── CTA hover ───────────────────────────────────────────── */
.cc-panel-sol__cta:hover {
  background: #96c434;
}

/* ── Tab panel transitions ───────────────────────────────── */
.cc-tab-panels {
  position: relative;
}
.cc-tab-panel.is-hidden {
  opacity: 0;
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  pointer-events: none;
  transition: opacity 0.25s ease;
}
.cc-tab-panel.is-active {
  opacity: 1;
  position: relative;
  pointer-events: auto;
  transition: opacity 0.25s ease;
}


/* ── First Tab Item Left Margin  ───────────────────────────────── */

   .cc-tab-item:first-child {
  margin-left: 30px; /* adjust to taste */
}

   /* ── Pill bar — LRAD Accessories page variant ────────────── */
.cc-pill-bar-access {
  background: #ffffff;
}

/* Label stays dark in both default and active states */
.cc-pill-item__label-access {
  color: #0d2233;
}
.cc-pill-item--active .cc-pill-item__label-access {
  color: #0d2233;
  font-weight: 600;
}

/* Hover — only non-active pills */
.cc-pill-item:not(.cc-pill-item--active):hover .cc-pill-item__label-access {
  color: #0d2233;
}

   /* Range bar for LRAD Products Page*/
.cc-range-bar {
  background-image: radial-gradient(circle, #FFFFFF 1px, transparent 1px);
  background-size: 10px 10px;
  background-color: transparent;
}

/* Range filler — default state */
.cc-range-fill {
  width: 0;
  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}
/* Hide Form block on the Resource pages */
   .filter-select_form .w-form { margin: 0; }
.filter-select_form .w-form-done,
.filter-select_form .w-form-fail { display: none !important; }

/* Copy Resource Page Link */
   [data-share="copy"] {
    position: relative;
  }

  [data-share="copy"]::after {
    content: 'Copied!';
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: #0d2233;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  [data-share="copy"].is-copied::after {
    opacity: 1;
  }
@media screen and (max-width: 767px) {
    .fs-dropdown_list-3.w--open
 {
        transform: none;
   		left:0;
  }
}  
</style></div><div class="w-embed w-script"><script>
  // ---- Detect default and mark default font size increase (for accessibility) ----
  (function() {
    function detectFontSizeIncrease() {
      // Get the root font size in pixels
      const rootFontSize = parseFloat(
        getComputedStyle(document.documentElement).fontSize
      );
      // Default is typically 16px
      const defaultSize = 16;
      const multiplier = rootFontSize / defaultSize;
      // Add or remove class based on multiplier
      if (multiplier >= 2) {
        document.body.classList.add('font-size-increased');
      } else {
        document.body.classList.remove('font-size-increased');
      }
    }
    // Run on load
    detectFontSizeIncrease();
    // Watch for changes (when user adjusts font size)
    const observer = new ResizeObserver(() => {
      detectFontSizeIncrease();
    });
    observer.observe(document.documentElement);
  })();

  // ---- Update foot year to current year ----
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-footer-year]').forEach(el => {
      el.textContent = new Date().getFullYear();
    });
  });
</script>
<script>
// ── Genasys Home Hero JS ──────────────────────────────
// 1. Typewriter rotation   2. Stats count-up on scroll

document.addEventListener('DOMContentLoaded', function () {

  // ── 1. TYPEWRITER ────────────────────────────────────
  const el = document.getElementById('homeHeroTypewriter');
  const phrases = [
    'you need to collaborate with other police, quickly and securely?',
    'flood waters are rising fast in the county?',
    'a major road is blocked, creating issues, inquiries and incoming calls?',
    'you need to communicate from distance, clearly to de-escalate tension?',
    'a fire is moving towards your community?'
  ];

  let phraseIndex = 0;
  let charIndex   = 0;
  let isDeleting  = false;

  const TYPE_SPEED   = 42;   // ms per character when typing
  const DELETE_SPEED = 10;   // ms per character when deleting
  const PAUSE_END    = 2400; // ms pause after full phrase is typed
  const PAUSE_START  = 400;  // ms pause before next phrase begins

  function tick() {
    if (!el) return;
    const phrase = phrases[phraseIndex];

    if (isDeleting) {
      charIndex--;
      el.textContent = phrase.slice(0, charIndex);
    } else {
      charIndex++;
      el.textContent = phrase.slice(0, charIndex);
    }

    let delay = isDeleting ? DELETE_SPEED : TYPE_SPEED;

    if (!isDeleting && charIndex === phrase.length) {
      delay = PAUSE_END;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      delay = PAUSE_START;
    }

    setTimeout(tick, delay);
  }

  tick();


// ── 2. COUNT-UP STATS ────────────────────────────────
const statsEl  = document.getElementById('homeStats');
const counters = document.querySelectorAll('.home-stats_count');
let   hasRun   = false;

function animateCount(el) {
  const target   = parseFloat(el.dataset.target);
  const suffix   = el.dataset.suffix ? el.dataset.suffix.trim() : '';
  const decimals = el.dataset.target.includes('.')
                   ? el.dataset.target.split('.')[1].length
                   : 0;
  const duration = 1800;
  const start    = performance.now();

  function step(now) {
    const elapsed  = now - start;
    const progress = Math.min(elapsed / duration, 1);
    const eased    = 1 - Math.pow(1 - progress, 3);
    const value    = (eased * target).toFixed(decimals);
    el.textContent = value + suffix;
    if (progress < 1) requestAnimationFrame(step);
  }

  requestAnimationFrame(step);
}

const observer = new IntersectionObserver(
  function(entries) {
    if (entries[0].isIntersecting && !hasRun) {
      hasRun = true;
      counters.forEach(function(c) { animateCount(c); });
      observer.disconnect();
    }
  },
  { threshold: 0.3 }
);

if (statsEl) observer.observe(statsEl);

});
// Search Results: extract published date from indexed result text
function setSearchResultDates() {
  const monthPattern =
    '(January|February|March|April|May|June|July|August|September|October|November|December)';

  const dateRegex = new RegExp(
    '\\b' + monthPattern + '\\s+\\d{1,2},\\s+\\d{4}\\b',
    'i'
  );

  document.querySelectorAll('.w-dyn-item').forEach(function(item) {
    const dateEl = item.querySelector('.cc-search-result-date');
    const snippetEl = item.querySelector('.cc-search-result-snippet');

    if (!dateEl || !snippetEl) return;

    const match = snippetEl.textContent.match(dateRegex);

    if (match) {
      dateEl.textContent = match[0];
      dateEl.style.display = '';
    } else {
      dateEl.textContent = '';
      dateEl.style.display = 'none';
    }
  });
}

document.addEventListener('DOMContentLoaded', setSearchResultDates);
  </script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const floatingButton = document.querySelector('.cc-floating-modal-trigger');
  const footer = document.querySelector('.cc-footer');

  if (!floatingButton || !footer) return;

  const observer = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          floatingButton.classList.add('is-hidden');
        } else {
          floatingButton.classList.remove('is-hidden');
        }
      });
    },
    {
      threshold: 0.05
    }
  );

  observer.observe(footer);
});
</script>


<script>
document.addEventListener('click', function(e) {
  const btn = e.target.closest('[data-share]');
  if (!btn) return;

  const platform = btn.dataset.share;
  const url = encodeURIComponent(window.location.href);
  const title = encodeURIComponent(document.title);

  if (platform === 'copy') {
    navigator.clipboard.writeText(decodeURIComponent(url)).then(() => {
      btn.classList.add('is-copied');
      setTimeout(() => btn.classList.remove('is-copied'), 2000);
    });
    return;
  }

  const links = {
    linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`,
    email:    `mailto:?subject=${title}&body=${url}`,
    x:        `https://x.com/intent/tweet?url=${url}&text=${title}`,
    bluesky:  `https://bsky.app/intent/compose?text=${title}%20${url}`,
    facebook: `https://www.facebook.com/sharer/sharer.php?u=${url}`
  };

  window.open(links[platform], '_blank', 'width=600,height=500');
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const resultsList = document.querySelector(".cc-search-results-list");
  const loadMore = document.querySelector(".cc-search-load-more");

  if (!resultsList || !loadMore) return;

  // Get all search result items
  const results = Array.from(resultsList.children);

  const resultsPerPage = 10;
  let visibleResults = resultsPerPage;

  function updateResults() {
    // Show only the required number of results
    results.forEach((result, index) => {
      if (index < visibleResults) {
        result.style.display = "";
      } else {
        result.style.display = "none";
      }
    });

    // Hide Load More when all available results are visible
    if (visibleResults >= results.length) {
      loadMore.style.display = "none";
    } else {
      loadMore.style.display = "";
    }
  }

  loadMore.addEventListener("click", function (event) {
    event.preventDefault();

    visibleResults += resultsPerPage;
    updateResults();
  });

  // Initial state
  updateResults();
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

  const output = document.querySelector('.cc-selected-topics_inner');
  const selectedBar = document.querySelector('.cc-selected-topics_bar');

  if (!output || !selectedBar) return;

  // Keep the bar in the layout at all times
  selectedBar.style.visibility = 'hidden';
  selectedBar.style.opacity = '0';

  // Optional smooth fade
  selectedBar.style.transition = 'opacity 0.2s ease';

  function renderTopicTags() {

    // Remove previously generated tags
    output.querySelectorAll('.cc-selected-topic_tag').forEach(function(tag) {
      tag.remove();
    });

    // Find all checked Topic checkboxes
    const checkedTopics = document.querySelectorAll(
      '.cc-checkbox-item input[type="checkbox"]:checked'
    );

    // Keep layout space, only hide/show visually
    if (checkedTopics.length) {
      selectedBar.style.visibility = 'visible';
      selectedBar.style.opacity = '1';
    } else {
      selectedBar.style.visibility = 'hidden';
      selectedBar.style.opacity = '0';
    }

    checkedTopics.forEach(function(checkbox) {

      // Find the label connected to this checkbox
      let label = null;

      if (checkbox.labels && checkbox.labels.length) {
        label = checkbox.labels[0];
      }

      if (!label && checkbox.id) {
        label = document.querySelector(
          'label[for="' + CSS.escape(checkbox.id) + '"]'
        );
      }

      if (!label) return;

      const topicName = label.textContent.trim();
      if (!topicName) return;

      // Create tag
      const tag = document.createElement('div');
      tag.className = 'cc-selected-topic_tag';

      // Topic text
      const text = document.createElement('span');
      text.className = 'cc-selected-topic_text';
      text.textContent = topicName;

      // Remove button
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'cc-selected-topic_remove';
      remove.innerHTML = '&times;';
      remove.setAttribute('aria-label', 'Remove ' + topicName);

      remove.addEventListener('click', function () {
        checkbox.click();

        setTimeout(renderTopicTags, 100);
      });

      tag.appendChild(text);
      tag.appendChild(remove);

      output.appendChild(tag);
    });
  }

  // Update tags whenever Topic checkbox selection changes
  document.addEventListener('change', function(e) {

    if (
      e.target.matches(
        '.cc-checkbox-item input[type="checkbox"]'
      )
    ) {
      setTimeout(renderTopicTags, 100);
    }

  });

  // Initial rendering, including URL-loaded filters
  setTimeout(renderTopicTags, 500);
  setTimeout(renderTopicTags, 1200);
  setTimeout(renderTopicTags, 2000);

});
</script></div><div><div><div class="w-embed"><style>
