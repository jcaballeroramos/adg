/* ── Genasys Mobile Nav CSS ──────────────────────────── */
.mobile-nav_overlay {
  opacity: 0;
  transition: opacity 0.25s ease;
}
.nav-link {
  color: #163443;
}
  
.mobile-nav_overlay.is-visible {
  opacity: 1;
}
.mobile-sub_panel.is-hidden {
  transform: translateX(100%);
}
.mobile-sub_panel.is-open {
  transform: translateX(0);
  transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
}
.mobile-nav_scroll {
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  scrollbar-width: none;
}
.mobile-nav_scroll::-webkit-scrollbar { display: none; }
.mobile-nav_item:hover,
.mobile-utility_btn:hover,
.mobile-sub_cta:hover {
  background: #abcf38;
  border-color: #c5cdd4;
}
.mobile-sub_link:hover {
  color: #1a3347;
  padding-left: 4px;
  transition: padding-left 0.15s ease, color 0.15s ease;
}
.mobile-sub_arrow-link:hover {
  color: #1a3347;
  gap: 13px;
  transition: gap 0.15s ease, color 0.15s ease;
}
  .mobile-nav_close {
  color: #0d2233;
}
  
</style></div><div class="u-d-none w-embed w-script"><script>
	//---- Skip to <main> backup if #main anchor link isn't set ----
  document.addEventListener('DOMContentLoaded', () => {
    const skipLinkEle = document.getElementById('skip-link');
    if (!skipLinkEle) return;

    skipLinkEle.addEventListener('click', handleSkipLink);
    skipLinkEle.addEventListener('keydown', handleSkipLink);
  });

  function handleSkipLink(e) {
    if (e.type === 'keydown' && e.key !== 'Enter') return;

    e.preventDefault();
    const target = document.querySelector('main');
    target.setAttribute('tabindex', '-1');
    target.focus();
  }
</script>
<script>
// ── Genasys Mobile Nav JS ──────────────────────────────
// Separate from MAST dropdown JS.

document.addEventListener('DOMContentLoaded', function () {

  const trigger   = document.getElementById('mobileNavTrigger');
  const wrapper   = document.getElementById('mobileNavWrapper');
  const overlay   = document.getElementById('mobileOverlay');
  const navItems  = document.querySelectorAll('[data-submenu]');
  const subPanels = document.querySelectorAll('.mobile-sub_panel');
  const backBtns  = document.querySelectorAll('.mobile-back_btn');
  const allClose  = document.querySelectorAll('.mobile-nav_close');

  function resetAll() {
    if (wrapper) wrapper.style.display = 'none';
    if (overlay) overlay.classList.remove('is-visible');
    subPanels.forEach(function(p) {
      p.classList.remove('is-open');
      p.classList.add('is-hidden');
    });
    document.body.style.overflow = '';
  }

  resetAll();
  window.addEventListener('resize', function() {
    if (window.innerWidth > 991) resetAll();
  });

  function openMenu() {
    if (wrapper) wrapper.style.display = 'block';
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function() {
      if (overlay) overlay.classList.add('is-visible');
    });
  }

  function closeAll() {
    subPanels.forEach(function(p) {
      p.classList.remove('is-open');
      p.classList.add('is-hidden');
    });
    if (overlay) overlay.classList.remove('is-visible');
    if (wrapper) wrapper.style.display = 'none';
    document.body.style.overflow = '';
  }

  function openSub(key) {
    const panel = document.querySelector('[data-sub="' + key + '"]');
    if (panel) {
      panel.classList.remove('is-hidden');
      requestAnimationFrame(function() {
        panel.classList.add('is-open');
      });
    }
  }

  function closeSub() {
    subPanels.forEach(function(p) {
      p.classList.remove('is-open');
      p.classList.add('is-hidden');
    });
  }

  if (trigger) trigger.addEventListener('click', openMenu);
  if (overlay) overlay.addEventListener('click', closeAll);
  allClose.forEach(function(btn) { btn.addEventListener('click', closeAll); });
  backBtns.forEach(function(btn) { btn.addEventListener('click', closeSub); });
  navItems.forEach(function(item) {
    item.addEventListener('click', function() {
      openSub(this.dataset.submenu);
    });
  });

});
</script></div><a id="skip-link" href="#main" class="nav-skip-link">Skip to Main Content</a><div class="container cc-nav"><a href="/" class="nav-logo_link w-nav-brand"><img src="https://cdn.prod.website-files.com/69f39e369b14675d13fd1b1c/6aa3e12831c3f2ba95b69bd2_GENASYS_Logo_Horizontal_FullColor_web.svg" loading="lazy" alt=""/></a><div class="nav-menu_btn w-nav-button"><div class="nav-menu_btn-bar cc-top"></div><div class="nav-menu_btn-bar cc-middle"></div><div class="nav-menu_btn-bar cc-bottom"></div></div><nav role="navigation" class="nav-menu w-nav-menu"><div class="nav-dropdown_overlay"></div><div class="nav-menu_container"><div data-delay="0" data-hover="false" class="nav-dropdown cc-mega w-dropdown"><div class="nav-link cc-dropdown-btn w-dropdown-toggle"><div class="u-text-primary"><a href="#" class="link-5">LRAD</a></div><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="nav-dropdown_arrow"><path d="M16.293 9.29297L12 13.586L7.70697 9.29297L6.29297 10.707L12 16.414L17.707 10.707L16.293 9.29297Z" fill="currentColor" class="u-text-primary"></path></svg></div><nav class="nav-dropdown_content cc-mega w-dropdown-list"><div class="row row-gutterless"><div class="col col-lg-4 col-md-6 col-sm-12 mega-col_left"><ul role="list" class="u-mb-0 w-list-unstyled"><li class="u-text-primary"><img src="https://cdn.prod.website-files.com/69f39e369b14675d13fd1b1c/6aa443c96c2f7555e5cf9252_LRAD_Icon.svg" loading="lazy" alt="" class="drop-nav-icon"/><a href="/lrad-solutions" class="nav-link cc-dropdown-link cc-nav-icon w-dropdown-link"><strong>LRAD by Genasys</strong></a><div class="mega-menu-txt"><a href="/lrad-solutions" class="link">State of the art, long range acoustic devices for use across public safety and military applications.</a></div></li><li class="u-text-primary"><a href="/lrad-products" class="nav-link cc-dropdown-link cc-no-left-pad w-dropdown-link"><strong>View all LRAD Products</strong></a><div class="mega-menu-txt"><a href=