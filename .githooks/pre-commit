#!/bin/sh
# Bloquea el commit si aparece algo con forma de credencial.
# Instalado con: git config core.hooksPath .githooks

PAT='AIza[0-9A-Za-z_-]\{20,\}\|AQ\.[A-Za-z0-9_.-]\{20,\}\|sk-[A-Za-z0-9_-]\{20,\}\|ghp_[A-Za-z0-9]\{30,\}\|gho_[A-Za-z0-9]\{30,\}\|github_pat_[A-Za-z0-9_]\{50,\}\|xox[abpr]-[A-Za-z0-9-]\{10,\}\|hf_[A-Za-z0-9]\{30,\}\|r8_[A-Za-z0-9]\{30,\}\|ya29\.[A-Za-z0-9_-]\{20,\}\|-----BEGIN [A-Z ]*PRIVATE KEY-----\|GEMINI_API_KEY[[:space:]]*=[[:space:]]*["'"'"']\{0,1\}[A-Za-z0-9]'

HITS=$(git diff --cached -U0 | grep "^+" | grep "$PAT")

if [ -n "$HITS" ]; then
  echo ""
  echo "  ✗ COMMIT BLOQUEADO: hay algo con forma de credencial en los cambios."
  echo ""
  echo "$HITS" | cut -c1-70 | sed 's/^/    /' | head
  echo ""
  echo "  Las claves van SOLO en ~/.zshrc como variable de entorno, nunca en el repo."
  echo "  Si es un falso positivo:  git commit --no-verify"
  echo ""
  exit 1
fi
exit 0
