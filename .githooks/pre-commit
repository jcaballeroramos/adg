#!/bin/sh
# Bloquea el commit si aparece algo con forma de clave de API.
# Instalado con: git config core.hooksPath .githooks

PAT='AIza[0-9A-Za-z_-]\{20,\}\|sk-[A-Za-z0-9]\{32,\}\|ghp_[A-Za-z0-9]\{30,\}\|xox[abpr]-[A-Za-z0-9-]\{10,\}'

if git diff --cached -U0 | grep -n "^+" | grep -q "$PAT"; then
  echo ""
  echo "  ✗ COMMIT BLOQUEADO: hay algo con forma de clave de API en los cambios."
  echo ""
  git diff --cached -U0 | grep -n "^+" | grep "$PAT" | sed 's/\(.\{110\}\).*/\1…/' | head
  echo ""
  echo "  Saca la clave del fichero. Va SOLO en ~/.zshrc como variable de entorno."
  echo "  Si es un falso positivo:  git commit --no-verify"
  echo ""
  exit 1
fi
exit 0
